# MolCurator settings. scripts/setup.sh creates .env from this file; .env is gitignored.

# xTB needs no setting: it runs in-process through tblite (a Python dependency).

# Path to the ORCA binary (ORCA 6.1.1 or newer; install it yourself, free academic
# licence). Leave empty to use `orca` on PATH. Used by VALIDATE, and by PREDICT for
# targets xTB cannot give (TD-DFT for s1_t1_gap). PySCF fallback is not implemented.
ORCA_BIN=

# Open MPI folder (the one holding bin/mpirun and lib/, e.g. a conda env with openmpi), for
# ORCA runs on more than one core (orca_nprocs in the chemistry settings). Leave empty to
# use mpirun on PATH; not needed for 1 core. setup.sh fills this in when it finds one.
OPENMPI_HOME=

# Decision model. Default: Claude Haiku 4.5 through the Anthropic API (~2 s per decision).
# Get a key at https://console.anthropic.com and paste it below. Without a key, runs can
# use rule-based decisions (set `decisions: rules` in the run config).
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5

# Optional: any OpenAI-compatible endpoint instead (e.g. a local model in Ollama).
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=ollama

# Maximum seconds per ORCA process (xTB runs in-process and needs no limit).
MOLCURATOR_QC_TIMEOUT_S=600

# Optional JSON chemistry settings (conformers, ORCA cores/memory, timeout); start from
# configs/chemistry.example.json. Absolute paths recommended.
MOLCURATOR_CHEM_CONFIG=
