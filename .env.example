# MolCurator settings. scripts/setup.sh creates .env from this file; .env is gitignored.

# Path to the xtb binary (setup.sh fills this in). Leave empty to use `xtb` on PATH.
XTB_BIN=

# Reasoning model, through any OpenAI-compatible endpoint.
# Default: Qwen3 4B on local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama

# Hosted alternative (no local Ollama needed): replace the three values above, e.g.
# LLM_BASE_URL=https://<provider>/v1
# LLM_MODEL=<provider's model name>
# LLM_API_KEY=<your key>
