# MolCurator settings. scripts/setup.sh creates .env from this file; .env is gitignored.

# Path to the xtb binary (setup.sh fills this in). Leave empty to use `xtb` on PATH.
XTB_BIN=

# Path to the ORCA binary, the default quantum chemistry backend (install a current ORCA
# yourself; free academic licence). Leave empty to use `orca` on PATH.
# Current real validation requires ORCA; PySCF fallback is not implemented.
ORCA_BIN=

# Decision model. Default: Claude Haiku 4.5 through the Anthropic API (~2 s per decision).
# Get a key at https://console.anthropic.com and paste it below. Without a key, runs can
# use rule-based decisions (set `decisions: rules` in the run config).
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5

# Optional: any OpenAI-compatible endpoint instead (e.g. a local model in Ollama).
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=ollama

# Maximum seconds per external chemistry process.
MOLCURATOR_QC_TIMEOUT_S=600

# Optional JSON chemistry configuration; absolute paths recommended.
MOLCURATOR_CHEM_CONFIG=
