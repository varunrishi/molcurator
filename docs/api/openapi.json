 "components": {
  "schemas": {
   "ConfigBody": {
    "properties": {
     "config": {
      "additionalProperties": true,
      "type": "object",
      "title": "Config",
      "description": "A run config, as in configs/*.yaml (missing keys use defaults)."
     }
    },
    "type": "object",
    "required": [
     "config"
    ],
    "title": "ConfigBody"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "InspectBody": {
    "properties": {
     "smiles": {
      "type": "string",
      "title": "Smiles"
     },
     "xyz": {
      "type": "boolean",
      "title": "Xyz",
      "description": "Also return a quick 3D preview structure (XYZ).",
      "default": true
     }
    },
    "type": "object",
    "required": [
     "smiles"
    ],
    "title": "InspectBody"
   },
   "PlanBody": {
    "properties": {
     "prompt": {
