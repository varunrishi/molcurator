# Copy to config.env and edit; DO NOT commit credentials or proprietary data.
export MOLCURATOR_DATA_ROOT=/path/to/MolCurator
export MOLCURATOR_MODEL_DIR="$MOLCURATOR_DATA_ROOT/ml276"
export MOLCURATOR_DESIGN1_DIR="$MOLCURATOR_DATA_ROOT/design_qm9_0023"
export MOLCURATOR_DESIGN2_DIR="$MOLCURATOR_DATA_ROOT/design_iteration2"
export MOLCURATOR_SEED_ID=qm9_0023
export XTB_BIN=/path/to/xtb
export ORCA_BIN=/path/to/orca
# Optional override; by default points at repository legacy/extract_properties.py
# export MOLCURATOR_PARSER=/path/to/extract_properties.py
export MOLCURATOR_PYTHON=/path/to/conda/env/bin/python
export MOLCURATOR_PARTITION=short
